# Copy to .env and adjust if needed. Everything here runs locally and free.

# --- Neo4j ---
# Local Docker default. For cloud (Neo4j Aura Free) use a neo4j+s:// URI, e.g.
#   NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplychain

# --- Provider selection ---
# LLM_PROVIDER: "ollama" (local, default) or "groq" (cloud / Render deploy).
LLM_PROVIDER=ollama
# EMBED_PROVIDER: "ollama" (local, default) or "fastembed" (local ONNX, cloud).
EMBED_PROVIDER=ollama

# --- Ollama (local LLM + embeddings) ---
OLLAMA_HOST=http://localhost:11434
# Light 3B model for grounded answering (fits 16 GB comfortably).
# Fallbacks already on this machine: llama3.1:8b
LLM_MODEL=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text

# --- Groq (cloud LLM; used when LLM_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACT_MODEL=llama-3.1-8b-instant

# --- fastembed (local embeddings; used when EMBED_PROVIDER=fastembed) ---
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval tuning ---
TOP_K=6
MAX_HOPS=4
