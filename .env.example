# Copy to .env and adjust if needed. Everything here runs locally and free.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplychain

# --- Ollama (local LLM + embeddings) ---
OLLAMA_HOST=http://localhost:11434
# Light 3B model for grounded answering (fits 16 GB comfortably).
# Fallbacks already on this machine: llama3.1:8b
LLM_MODEL=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text

# --- Retrieval tuning ---
TOP_K=6
MAX_HOPS=4
